{
  "name": "turbo-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/node": "^22.15.3",
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2",
      "next": "16.3.0",
      "oxlint": "^1.78.0",
      "oxlint-tsgolint": "^7.0.2001",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "typescript": "7.0.2"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "oxfmt .",
    "check-types": "turbo run check-types",
    "format:check": "oxfmt --check .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "^2.10.9",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.12"
}
