{
  "name": "turbo-bun-ox-starter",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@oxlint/plugins": "^1.78.0",
      "@types/bun": "^1.3.14",
      "@types/node": "^22.15.3",
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2",
      "next": "16.3.0",
      "oxlint": "^1.78.0",
      "oxlint-tsgolint": "^7.0.2001",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "typescript": "7.0.2"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "oxfmt .",
    "check-types": "bun run typecheck:anti-slop && turbo run check-types",
    "format:check": "oxfmt --check .",
    "prepare": "lefthook install",
    "test": "bun run test:anti-slop && turbo run test",
    "test:anti-slop": "node tools/oxlint/anti-slop/test.mjs",
    "typecheck:anti-slop": "tsc -p tools/oxlint/anti-slop/tsconfig.json"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "^2.10.9",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24"
  },
  "packageManager": "bun@1.4.0"
}
